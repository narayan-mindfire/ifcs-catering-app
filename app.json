{
  "expo": {
    "name": "Galley X - Load",
    "slug": "ifcs-catering-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "ifcs-catering-app",
      "msauth.com.ifcs-catering.app"
    ],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ifcs-catering.app",
      "newArchEnabled": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSPhotoLibraryUsageDescription": "Allow IFCS to access your photo library to save downloaded files.",
        "NSPhotoLibraryAddUsageDescription": "Allow IFCS to save downloaded files to your photo library.",
        "NSCameraUsageDescription": "We need camera access to scan flight QR codes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "95UM4848X5",
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.narayanp.ifcscateringapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "We need camera access to scan flight QR codes."
        }
      ],
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow IFCS to access your photos.",
          "savePhotosPermission": "Allow IFCS to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-asset",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "44a1a9f3-fc70-4eab-99fb-d1bb3c3c5137"
      }
    }
  }
}
