{
  "expo": {
    "name": "ifcs-catering-app",
    "slug": "ifcs-catering-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.ifcscateringapp",
      "newArchEnabled": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library to save downloaded files.",
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to save downloaded files to your photo library.",
        "NSCameraUsageDescription": "We need camera access to scan flight QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "usesCleartextTraffic": true
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.narayanp.ifcscateringapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "We need camera access to scan flight QR codes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow IFCS to access your photos.",
          "savePhotosPermission": "Allow IFCS to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}